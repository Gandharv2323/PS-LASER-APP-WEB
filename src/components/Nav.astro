---
import { withBase } from '../lib/base';

const links = [
  { href: withBase('/services'), label: 'Services' },
  { href: withBase('/app'), label: 'App' },
  { href: withBase('/support'), label: 'Support' },
  { href: withBase('/about'), label: 'About' },
];
// Compared against pre-base-prefixed hrefs above, not the raw route
// strings, since Astro.url.pathname reflects the actually-served path
// (which includes the GitHub Pages sub-path once deployed).
const currentPath = Astro.url.pathname;
---

<header class="site-nav" data-nav>
  <div class="container nav-inner">
    <a href={withBase('/')} class="wordmark">PS LASER</a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={currentPath === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href={withBase('/app')} class="btn btn-primary nav-cta">Explore the App</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-nav-toggle>
        <span class="visually-hidden">Toggle menu</span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu>
    <nav class="mobile-links" aria-label="Mobile">
      <a href={withBase('/')}>Home</a>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={withBase('/contact')}>Contact</a>
    </nav>
    <a href={withBase('/app')} class="btn btn-primary" style="align-self:flex-start;">Explore the App</a>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 10, 10, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
    transition: border-color 0.3s ease;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--text-1);
  }

  .nav-links {
    display: none;
    gap: 36px;
  }
  .nav-links a {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-2);
    transition: color 0.2s ease;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--text-1);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav-cta {
    display: none;
    padding: 10px 20px;
    font-size: 0.875rem;
    min-height: 40px;
  }

  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    justify-content: center;
    align-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: pointer;
  }
  .nav-toggle .bar {
    width: 18px;
    height: 1.5px;
    background: var(--text-1);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .nav-toggle[aria-expanded='true'] .bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 28px;
    padding: 28px var(--gutter) 40px;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-0);
  }
  .mobile-menu.is-open {
    display: flex;
  }
  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-links a {
    text-decoration: none;
    color: var(--text-1);
    font-family: var(--font-display);
    font-size: 1.5rem;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 900px) {
    .nav-links {
      display: flex;
    }
    .nav-cta {
      display: inline-flex;
    }
    .nav-toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('is-open', !isOpen);
  });

  // Close the mobile menu on navigation (menu links are same-page anchors
  // to other routes — Astro does a full page load, so this mainly guards
  // back/forward-cache restoring the menu in an open state).
  window.addEventListener('pageshow', () => {
    toggle?.setAttribute('aria-expanded', 'false');
    menu?.classList.remove('is-open');
  });
</script>
