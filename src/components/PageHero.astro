---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h1 class="page-title reveal">{title}</h1>
    {intro && <p class="page-intro reveal">{intro}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(56px, 12vh, 120px) clamp(40px, 6vh, 64px);
  }
  .page-title {
    font-size: var(--size-h1);
    margin-top: 16px;
    max-width: 20ch;
  }
  .page-intro {
    margin-top: 24px;
    font-size: var(--size-body-lg);
    max-width: 58ch;
  }
</style>
