---
import { withBase } from '../lib/base';

// Real app screenshots (provided by the app's owner, never generated or
// fabricated — see scripts/optimize-screenshots.mjs) render inside this
// same phone-frame chrome as the placeholder below, so sections with and
// without a real screenshot look like one consistent system rather than
// two different components. Pass `slug` + `alt` once a screenshot exists
// for a section; omit both to keep the honest "coming soon" placeholder.
interface Props {
  label: string;
  slug?: string;
  alt?: string;
}
const { label, slug, alt } = Astro.props;
---

{slug ? (
  <figure class="screenshot-frame">
    <picture>
      <source srcset={withBase(`/screenshots/${slug}.webp`)} type="image/webp" />
      <img
        src={withBase(`/screenshots/${slug}.jpg`)}
        alt={alt ?? label}
        loading="lazy"
        decoding="async"
        width="600"
        height="1600"
      />
    </picture>
    <figcaption class="visually-hidden">{alt ?? label}</figcaption>
  </figure>
) : (
  <div class="placeholder-frame" role="img" aria-label={`Screenshot placeholder: ${label}`}>
    <div class="frame-inner">
      <span class="frame-label">{label}</span>
      <span class="frame-note">Screenshot coming soon</span>
    </div>
  </div>
)}

<style>
  .screenshot-frame,
  .placeholder-frame {
    width: 100%;
    max-width: 300px;
    border-radius: 28px;
    border: 1px solid var(--border);
    padding: 10px;
    margin: 0;
    background:
      radial-gradient(circle at 30% 15%, rgba(219, 174, 69, 0.08), transparent 55%),
      linear-gradient(180deg, var(--bg-card), var(--bg-1));
  }
  .screenshot-frame {
    /* Real screenshots carry their own shadow/depth via the frame below —
       kept deliberately subtle, consistent with the site's restrained
       motion/effects posture. No distortion: the image sizes to its own
       natural aspect ratio inside the frame, never stretched or cropped. */
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }
  .screenshot-frame picture,
  .screenshot-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .placeholder-frame {
    aspect-ratio: 9 / 17.5;
  }
  .frame-inner {
    height: 100%;
    width: 100%;
    border-radius: 20px;
    border: 1px dashed var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    padding: 20px;
  }
  .frame-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text-1);
  }
  .frame-note {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
</style>
