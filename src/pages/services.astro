---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { withBase } from '../lib/base';

const services = [
  {
    num: '01',
    title: 'Laser Cutting',
    detail:
      'The first production stage tracked for a cut part. Assigned to specific machines and, where allocated, specific workers — progress is logged against the order in real time rather than reconstructed later.',
    meta: 'Process type · LASER',
  },
  {
    num: '02',
    title: 'Punching',
    detail:
      'A distinct stage in the same tracked sequence, with its own eligible-worker list and machine assignment — handled with the same visibility as every other stage, not a side process.',
    meta: 'Process type · PUNCHING',
  },
  {
    num: '03',
    title: 'Powder Coating',
    detail:
      'The finishing stage before packaging and dispatch. Once complete, an order moves toward Ready for Dispatch and into the Delivery Hub.',
    meta: 'Process type · POWDER_COATING',
  },
];
---

<BaseLayout
  title="Services"
  description="The three production stages PS Laser tracks: Laser Cutting, Punching, and Powder Coating."
  path="/services"
>
  <PageHero
    eyebrow="Services"
    title="Three stages. One tracked sequence."
    intro="Every order's parts move through a defined production sequence — assigned to machines, and where needed, to specific workers, with progress logged at every stage."
  />

  <section class="section">
    <div class="container services-list">
      {services.map((s) => (
        <article class="service-block reveal">
          <span class="num">{s.num}</span>
          <div class="body">
            <h2>{s.title}</h2>
            <p>{s.detail}</p>
            <span class="meta">{s.meta}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <hr class="divider container" />

  <section class="section">
    <div class="container cta">
      <h2 class="reveal">See how a stage moves through the app.</h2>
      <a class="btn btn-primary reveal" href={withBase('/app')}>Explore the App</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: var(--section-gap);
  }
  .services-list {
    display: flex;
    flex-direction: column;
  }
  .service-block {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 28px;
    padding-block: 44px;
    border-top: 1px solid var(--border-subtle);
  }
  .service-block:last-child {
    border-bottom: 1px solid var(--border-subtle);
  }
  .num {
    font-family: var(--font-mono);
    color: var(--gold);
    font-size: 1rem;
  }
  .body h2 {
    font-size: var(--size-h3);
    margin-bottom: 12px;
  }
  .body p {
    max-width: 62ch;
    font-size: var(--size-body-lg);
  }
  .meta {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--text-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 14px;
  }

  .cta {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  .cta h2 {
    font-size: var(--size-h2);
    max-width: 16ch;
  }
</style>
