---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { withBase } from '../lib/base';

const topics = [
  {
    title: 'Login & PIN issues',
    copy: 'Trouble signing in, or need to reset a forgotten PIN? PS Laser uses a security question set at registration to recover access — no email link involved.',
  },
  {
    title: 'Account issues',
    copy: 'New account still pending approval, or need a role/department corrected? An Owner or Manager on your team can review this from User Management, or contact us directly.',
  },
  {
    title: 'Order issues',
    copy: 'Questions about an order that isn’t showing the right status, part, or attachment.',
  },
  {
    title: 'Notification issues',
    copy: 'Not receiving order or delivery alerts? Check notification permissions for the app, and confirm you’re signed in on the device you expect alerts on.',
  },
];
---

<BaseLayout
  title="Support"
  description="Get help with PS Laser — login issues, account questions, order issues, notifications, and how to reach our support team directly."
  path="/support"
>
  <PageHero
    eyebrow="Support"
    title="Help, from a real person."
    intro="No ticket queue, no bot — support requests go directly to our team by email."
  />

  <section class="section">
    <div class="container support-grid">
      <div class="reveal">
        <h2>Common topics</h2>
        <div class="topics">
          {topics.map((t) => (
            <div class="topic">
              <h3>{t.title}</h3>
              <p>{t.copy}</p>
            </div>
          ))}
        </div>
      </div>

      <aside class="contact-card reveal">
        <p class="eyebrow">Contact Support</p>
        <a class="email" href="mailto:pslaser24@gmail.com">pslaser24@gmail.com</a>
        <p class="note">We read every message ourselves — expect a reply directly from our team.</p>
        <a class="btn btn-primary" href="mailto:pslaser24@gmail.com?subject=PS%20Laser%20Support%20Request">
          Report a Problem
        </a>
        <hr class="divider" style="margin: 24px 0;" />
        <a href={withBase('/faq')}>Read the FAQ →</a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: var(--section-gap);
  }
  .support-grid {
    display: grid;
    gap: 48px;
  }
  .support-grid h2 {
    font-size: var(--size-h3);
    margin-bottom: 24px;
  }
  .topics {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .topic {
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .topic h3 {
    font-size: 1.0625rem;
    margin-bottom: 8px;
    color: var(--text-1);
  }
  .topic p {
    font-size: 0.9375rem;
  }

  .contact-card {
    align-self: start;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-card);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .contact-card .email {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--gold-light);
    text-decoration: none;
    margin-top: 6px;
  }
  .contact-card .note {
    margin-top: 10px;
    margin-bottom: 20px;
    font-size: 0.875rem;
  }
  .contact-card a[href^='/faq'] {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.9375rem;
    margin-top: 4px;
  }
  .contact-card a[href^='/faq']:hover {
    color: var(--gold-light);
  }

  @media (min-width: 900px) {
    .support-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
